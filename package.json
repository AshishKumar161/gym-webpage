{
  "name": "a2-revamp-gym-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:api": "node apps/api/server.js",
    "build": "npm --prefix apps/web run build",
    "test": "npm --prefix apps/api test"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  }
}
