// This is your Prisma schema file for FitForge Pro
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  MEMBER
  TRAINER
  ADMIN
  OWNER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FROZEN
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  CASH
  COMPLIMENTARY
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  GENERAL_FITNESS
  ATHLETIC_PERFORMANCE
  FLEXIBILITY
  MENTAL_WELLNESS
  REHABILITATION
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ATHLETE
}

enum ClassStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum NotificationType {
  MEMBERSHIP_EXPIRY
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  CLASS_REMINDER
  TRAINER_BOOKING
  ACHIEVEMENT
  REFERRAL
  SYSTEM
}

enum RewardType {
  EARNED
  REDEEMED
  EXPIRED
  BONUS
}

enum InquiryType {
  membership
  training
  diet
  corporate
  other
}

enum InquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── User ─────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  firstName String
  lastName  String
  role      Role     @default(MEMBER)

  // Auth
  passwordHash      String?
  googleId          String?  @unique
  isEmailVerified   Boolean  @default(false)
  emailVerifyToken  String?
  emailVerifyExpiry DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret   String?
  isActive          Boolean  @default(true)
  isLocked          Boolean  @default(false)
  loginAttempts     Int      @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  lastLoginIp       String?

  // Profile
  avatarUrl            String?
  dateOfBirth          DateTime?
  gender               Gender?
  address              String?
  city                 String?
  state                String?
  country              String?  @default("India")
  emergencyContactName  String?
  emergencyContactPhone String?

  // Fitness Profile
  heightCm     Float?
  weightKg     Float?
  fitnessGoal  FitnessGoal?
  fitnessLevel FitnessLevel?

  // Referral
  referredBy    String?

  // Relations
  memberships       Membership[]
  payments          Payment[]
  attendance        Attendance[]
  workoutSessions   WorkoutSession[]
  trainerProfile    TrainerProfile?
  trainerBookings   TrainerBooking[]  @relation("BookedByMember")
  trainerAssigned   TrainerBooking[]  @relation("AssignedTrainer")
  notifications     Notification[]
  rewardPoints      RewardPoint[]
  reviews           Review[]
  classBookings     ClassBooking[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  dietPlans         DietPlan[]
  referralCode      ReferralCode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ─── Refresh Token ────────────────────────────────────────────────────────

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  ipAddress  String?
  deviceInfo String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── Membership Plan ──────────────────────────────────────────────────────

model MembershipPlan {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  color       String  @default("#F5A623")
  icon        String?

  // Pricing (in paise for Razorpay, cents for Stripe)
  priceMonthly  Int
  priceQuarterly Int?
  priceHalfYearly Int?
  priceYearly   Int?
  originalPrice Int

  // Features
  features        String[]
  maxGuestPasses  Int     @default(0)
  trainerSessions Int     @default(0) // per month
  isActive        Boolean @default(true)
  displayOrder    Int     @default(0)

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("membership_plans")
}

// ─── Membership ───────────────────────────────────────────────────────────

model Membership {
  id     String           @id @default(cuid())
  userId String
  planId String
  status MembershipStatus @default(PENDING)

  startDate  DateTime
  endDate    DateTime
  autoRenew  Boolean  @default(false)

  // QR Code
  qrCode      String? @unique
  qrCodeImage String?

  // Freeze
  frozenAt      DateTime?
  frozenUntil   DateTime?
  freezeDaysUsed Int       @default(0)

  // Coupon Applied
  couponId String?

  user    User           @relation(fields: [userId], references: [id])
  plan    MembershipPlan @relation(fields: [planId], references: [id])
  coupon  Coupon?        @relation(fields: [couponId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@map("memberships")
}

// ─── Payment ──────────────────────────────────────────────────────────────

model Payment {
  id           String         @id @default(cuid())
  userId       String
  membershipId String?
  amount       Int            // in paise
  currency     String         @default("INR")
  status       PaymentStatus  @default(PENDING)
  gateway      PaymentGateway @default(RAZORPAY)

  // Gateway specific
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  receiptId        String?

  // Razorpay
  razorpayOrderId   String?
  razorpayPaymentId String?

  // Stripe
  stripePaymentIntentId String?

  // Metadata
  description  String?
  invoiceUrl   String?
  refundAmount Int?
  refundReason String?
  refundedAt   DateTime?
  failureReason String?

  user       User        @relation(fields: [userId], references: [id])
  membership Membership? @relation(fields: [membershipId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([gatewayOrderId])
  @@index([createdAt])
  @@map("payments")
}

// ─── Attendance ───────────────────────────────────────────────────────────

model Attendance {
  id          String   @id @default(cuid())
  userId      String
  checkInTime DateTime @default(now())
  checkOutTime DateTime?
  durationMins Int?
  method      String   @default("QR") // QR, MANUAL, BIOMETRIC
  notes       String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([checkInTime])
  @@map("attendance")
}

// ─── Trainer Profile ──────────────────────────────────────────────────────

model TrainerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  specializations String[]
  certifications  String[]
  experience  Int      @default(0) // years
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  isAvailable Boolean  @default(true)
  hourlyRate  Int?     // in paise
  instagram   String?
  youtube     String?

  user     User             @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trainer_profiles")
}

// ─── Trainer Booking ─────────────────────────────────────────────────────

model TrainerBooking {
  id          String        @id @default(cuid())
  memberId    String
  trainerId   String
  scheduledAt DateTime
  durationMins Int          @default(60)
  status      BookingStatus @default(CONFIRMED)
  notes       String?
  sessionNotes String?
  cancelReason String?

  member  User           @relation("BookedByMember", fields: [memberId], references: [id])
  trainer User           @relation("AssignedTrainer", fields: [trainerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([trainerId])
  @@index([scheduledAt])
  @@map("trainer_bookings")
}

// ─── Workout Session ─────────────────────────────────────────────────────

model WorkoutSession {
  id          String  @id @default(cuid())
  userId      String
  name        String
  status      String  @default("COMPLETED") // PLANNED, IN_PROGRESS, COMPLETED, SKIPPED
  startedAt   DateTime
  completedAt DateTime?
  durationMins Int?
  caloriesBurned Int?
  notes       String?

  user      User             @relation(fields: [userId], references: [id])
  exercises WorkoutExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([startedAt])
  @@map("workout_sessions")
}

// ─── Workout Exercise ─────────────────────────────────────────────────────

model WorkoutExercise {
  id          String @id @default(cuid())
  sessionId   String
  name        String
  sets        Int?
  reps        Int?
  weightKg    Float?
  durationSecs Int?
  distanceKm  Float?
  notes       String?

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("workout_exercises")
}

// ─── Group Class ─────────────────────────────────────────────────────────

model GroupClass {
  id          String      @id @default(cuid())
  name        String
  description String?
  trainerId   String?
  scheduledAt DateTime
  durationMins Int        @default(60)
  capacity    Int         @default(20)
  status      ClassStatus @default(SCHEDULED)
  location    String?     @default("Main Studio")
  imageUrl    String?
  category    String?     // yoga, crossfit, zumba, etc.
  difficulty  String?

  bookings ClassBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledAt])
  @@map("group_classes")
}

// ─── Class Booking ───────────────────────────────────────────────────────

model ClassBooking {
  id       String        @id @default(cuid())
  userId   String
  classId  String
  status   BookingStatus @default(CONFIRMED)
  position Int?          // for waitlist

  user       User       @relation(fields: [userId], references: [id])
  groupClass GroupClass @relation(fields: [classId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, classId])
  @@index([userId])
  @@index([classId])
  @@map("class_bookings")
}

// ─── Diet Plan ───────────────────────────────────────────────────────────

model DietPlan {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  calories    Int?
  protein     Int?     // grams
  carbs       Int?     // grams
  fat         Int?     // grams
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdBy   String?  // trainer ID

  user  User       @relation(fields: [userId], references: [id])
  meals DietMeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("diet_plans")
}

// ─── Diet Meal ───────────────────────────────────────────────────────────

model DietMeal {
  id         String  @id @default(cuid())
  planId     String
  name       String
  mealType   String  // breakfast, lunch, dinner, snack
  calories   Int?
  protein    Float?
  carbs      Float?
  fat        Float?
  foods      String[]
  recipeUrl  String?

  plan DietPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("diet_meals")
}

// ─── Gallery ─────────────────────────────────────────────────────────────

model GalleryImage {
  id          String   @id @default(cuid())
  title       String?
  description String?
  imageUrl    String
  publicId    String?  // Cloudinary public ID
  category    String   @default("Facility")
  isPublished Boolean  @default(true)
  displayOrder Int     @default(0)
  uploadedBy  String?

  createdAt DateTime @default(now())

  @@map("gallery_images")
}

// ─── Blog Post ───────────────────────────────────────────────────────────

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  authorId    String?
  tags        String[]
  readTimeMins Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("blog_posts")
}

// ─── Review ──────────────────────────────────────────────────────────────

model Review {
  id          String  @id @default(cuid())
  userId      String
  rating      Int     // 1-5
  title       String?
  comment     String
  isApproved  Boolean @default(false)
  isPublished Boolean @default(false)
  metrics     String? // e.g. "Lost 15 kg in 3 months"

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isPublished])
  @@map("reviews")
}

// ─── Notification ────────────────────────────────────────────────────────

model Notification {
  id       String           @id @default(cuid())
  userId   String
  type     NotificationType
  title    String
  body     String
  isRead   Boolean          @default(false)
  readAt   DateTime?
  data     Json?
  imageUrl String?
  actionUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Contact Inquiry ─────────────────────────────────────────────────────

model ContactInquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String
  subject     String
  message     String
  inquiryType String        @default("other")
  status      InquiryStatus @default(PENDING)
  assignedTo  String?
  response    String?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("contact_inquiries")
}

// ─── Coupon ──────────────────────────────────────────────────────────────

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  discountType    String   // PERCENTAGE, FIXED
  discountValue   Int      // percentage or paise
  maxUses         Int?
  usedCount       Int      @default(0)
  minOrderValue   Int?
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  isActive        Boolean  @default(true)
  appliesTo       String[] // plan slugs, or empty for all

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

// ─── Reward Points ───────────────────────────────────────────────────────

model RewardPoint {
  id          String     @id @default(cuid())
  userId      String
  points      Int
  type        RewardType
  description String
  referenceId String?    // order ID, achievement ID, etc.
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("reward_points")
}

// ─── Referral Code ───────────────────────────────────────────────────────

model ReferralCode {
  id     String @id @default(cuid())
  userId String @unique
  code   String @unique

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("referral_codes")
}

// ─── Audit Log ───────────────────────────────────────────────────────────

model AuditLog {
  id           String  @id @default(cuid())
  userId       String?
  action       String
  resource     String
  resourceId   String?
  oldData      Json?
  newData      Json?
  ipAddress    String?
  userAgent    String?
  success      Boolean @default(true)
  errorMessage String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
