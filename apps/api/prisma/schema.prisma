generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS

enum PlanDuration {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  FROZEN
  CANCELLED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

// ==========================================
enum RoleType {
  SUPER_ADMIN
  MANAGER
  TRAINER
  MEMBER
  RECEPTIONIST
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  FROZEN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AttendanceMethod {
  QR_CODE
  BIOMETRIC
  MANUAL
}

// ==========================================
// 1. AUTHENTICATION & BRANCHES
// ==========================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?   @unique
  avatarUrl    String?
  isActive     Boolean   @default(true)
  emailVerifiedAt DateTime?
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Auth additions
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  lastPasswordChangeAt     DateTime?

  // Relations
  
  gymId        String?
  gym          Gym?      @relation(fields: [gymId], references: [id])
  memberProfile MemberProfile?

  roles       UserRole[]
  sessions    Session[]
  attendances Attendance[]
  invoices    Invoice[]

  // Profiles
  trainerProfile TrainerProfile?

  @@index([email])
  @@index([lastName, firstName, phone]) // Phase 7: Search Index
  @@index([branchId])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleType @unique
  description String?

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String    @id @default(uuid())
  action      String    // "create", "read", "update", "delete", "manage"
  resource    String    // "member", "trainer", "payment", "report", "settings", "branch"
  description String?
  createdAt   DateTime  @default(now())

  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(uuid())
  role         RoleType
  permissionId String
  createdAt    DateTime  @default(now())

  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([refreshToken]) // Phase 7: Fast Session Lookup
  @@map("sessions")
}


model Gym {
  id              String           @id @default(uuid())
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users           User[]
  membershipPlans MembershipPlan[]

  @@map("gyms")
}

model Branch {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  address      String
  contactPhone String    @map("contact_phone")
  contactEmail String    @map("contact_email")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  users       User[]
  attendances Attendance[]
  invoices    Invoice[]
  inventory   InventoryItem[]
  equipment   Equipment[]
  classes     Class[]

  @@map("branches")
}

// ==========================================
// 2. PROFILES & MEMBERSHIPS
// ==========================================



model TrainerProfile {
  id             String  @id @default(uuid())
  userId         String  @unique @map("user_id")
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  experienceYrs  Int     @map("experience_years")
  bio            String?

  @@map("trainer_profiles")
}





// ==========================================
// 3. BILLING & ATTENDANCE
// ==========================================

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique @map("invoice_number")
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  branchId      String   @map("branch_id")
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  subtotal      Decimal  @db.Decimal(10, 2)
  tax           Decimal  @db.Decimal(10, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(10, 2)
  status        String   @default("UNPAID") // UNPAID, PAID, VOID
  dueDate       DateTime @map("due_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  payment Payment?

  @@index([userId, status]) // Phase 7: Find unpaid invoices per user
  @@index([branchId, dueDate]) // Phase 7: Revenue reporting by branch and date
  @@map("invoices")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String        @unique @map("invoice_id")
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountPaid    Decimal       @map("amount_paid") @db.Decimal(10, 2)
  paymentMethod String        @map("payment_method")
  transactionId String?       @unique @map("transaction_id")
  status        PaymentStatus @default(PENDING)
  processedAt   DateTime      @default(now()) @map("processed_at")

  @@index([processedAt(sort: Desc)]) // Phase 7: Fetch latest transactions quickly
  @@map("payments")
}

model Attendance {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId     String           @map("branch_id")
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  checkInTime  DateTime         @default(now()) @map("check_in_time")
  checkOutTime DateTime?        @map("check_out_time")
  entryMethod  AttendanceMethod @default(QR_CODE) @map("entry_method")

  @@index([userId, checkInTime]) // Phase 7: User's attendance history
  @@index([branchId, checkInTime(sort: Desc)]) // Phase 7: Who is currently at a branch
  @@map("attendances")
}

// ==========================================
// 4. INVENTORY & EQUIPMENT
// ==========================================

model InventoryItem {
  id       String  @id @default(uuid())
  branchId String  @map("branch_id")
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name     String
  sku      String  @unique
  quantity Int     @default(0)
  price    Decimal @db.Decimal(10, 2)

  @@index([branchId])
  @@map("inventory_items")
}

model Equipment {
  id            String    @id @default(uuid())
  branchId      String    @map("branch_id")
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name          String
  serialNumber  String?   @unique @map("serial_number")
  status        String    @default("ACTIVE") // ACTIVE, MAINTENANCE, RETIRED
  lastServiceAt DateTime? @map("last_service_at")

  @@index([branchId])
  @@map("equipment")
}

model Class {
  id       String @id @default(uuid())
  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name     String
  capacity Int

  @@map("classes")
}


// ═══════════════════════════════════════════════════════════
// MEMBERSHIP PLANS
// ═══════════════════════════════════════════════════════════

model MembershipPlan {
  id              String        @id @default(uuid())
  gymId           String
  name            String
  description     String?
  duration        PlanDuration
  durationInDays  Int           // Exact days (30, 90, 180, 365, or custom)
  price           Float
  discountedPrice Float?
  features        String[]      // Array of feature strings
  maxFreezes      Int           @default(1)
  freezeDaysLimit Int           @default(7)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  gym             Gym           @relation(fields: [gymId], references: [id])
  memberships     MemberMembership[]

  @@index([gymId])
  @@map("membership_plans")
}

// ═══════════════════════════════════════════════════════════
// MEMBER PROFILE (extends User)
// ═══════════════════════════════════════════════════════════

model MemberProfile {
  id                String      @id @default(uuid())
  gymId             String
  branchId          String
  userId            String      @unique
  memberId          String      @unique  // Human readable: "A2R-0001"
  gender            Gender?
  dateOfBirth       DateTime?
  bloodGroup        BloodGroup?
  emergencyContact  String?
  emergencyName     String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  weight            Float?      // in kg
  height            Float?      // in cm
  medicalConditions String?
  fitnessGoal       String?
  joinedAt          DateTime    @default(now())
  referralCode      String      @unique   // Auto-generated: "JOHN2024"
  referredBy        String?     // referralCode of the person who referred
  source            String?     // "WALK_IN", "REFERRAL", "SOCIAL_MEDIA", "WEBSITE", "OTHER"
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  user              User        @relation(fields: [userId], references: [id])
  memberships       MemberMembership[]
  notes             MemberNote[]
  trainerAssignment TrainerMemberAssignment?

  @@index([gymId])
  @@index([branchId])
  @@index([memberId])
  @@index([referralCode])
  @@map("member_profiles")
}

// ═══════════════════════════════════════════════════════════
// MEMBER MEMBERSHIP (plan assignment)
// ═══════════════════════════════════════════════════════════

model MemberMembership {
  id              String           @id @default(uuid())
  gymId           String
  memberProfileId String
  planId          String
  status          MembershipStatus @default(PENDING)
  startDate       DateTime
  endDate         DateTime
  actualEndDate   DateTime?        // Adjusted for freezes
  paidAmount      Float
  discountAmount  Float            @default(0)
  freezeCount     Int              @default(0)
  freezeStartDate DateTime?
  freezeEndDate   DateTime?
  totalFreezeDays Int              @default(0)
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  memberProfile   MemberProfile    @relation(fields: [memberProfileId], references: [id])
  plan            MembershipPlan   @relation(fields: [planId], references: [id])

  @@index([gymId])
  @@index([memberProfileId])
  @@index([status])
  @@index([endDate])
  @@map("member_memberships")
}

// ═══════════════════════════════════════════════════════════
// MEMBER NOTES
// ═══════════════════════════════════════════════════════════

model MemberNote {
  id              String    @id @default(uuid())
  gymId           String
  memberProfileId String
  createdById     String    // Staff who wrote the note
  content         String
  isPrivate       Boolean   @default(false)  // Private = only visible to managers+
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id])

  @@index([gymId])
  @@index([memberProfileId])
  @@map("member_notes")
}

// ═══════════════════════════════════════════════════════════
// TRAINER-MEMBER ASSIGNMENT
// ═══════════════════════════════════════════════════════════

model TrainerMemberAssignment {
  id              String    @id @default(uuid())
  gymId           String
  memberProfileId String    @unique
  trainerId       String    // User ID of trainer
  assignedAt      DateTime  @default(now())
  assignedById    String    // Manager/Owner who assigned
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id])

  @@index([gymId])
  @@index([trainerId])
  @@map("trainer_member_assignments")
}

// ═══════════════════════════════════════════════════════════
// STUB MODELS FOR SERVICES
// ═══════════════════════════════════════════════════════════

model MemberXP {
  id            String   @id @default(uuid())
  gymId         String
  memberId      String   @unique
  totalXp       Int      @default(0)
  level         String   @default("BRONZE")
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("member_xp")
}

model Referral {
  id           String   @id @default(uuid())
  gymId        String
  referrerId   String
  referredId   String
  referralCode String
  status       String   @default("SIGNED_UP")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("referrals")
}
