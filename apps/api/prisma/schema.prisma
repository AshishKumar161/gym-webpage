generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================
enum RoleType {
  SUPER_ADMIN
  MANAGER
  TRAINER
  MEMBER
  RECEPTIONIST
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  FROZEN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AttendanceMethod {
  QR_CODE
  BIOMETRIC
  MANUAL
}

// ==========================================
// 1. AUTHENTICATION & BRANCHES
// ==========================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?   @unique
  avatarUrl    String?
  isActive     Boolean   @default(true)
  emailVerifiedAt DateTime?
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Auth additions
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  lastPasswordChangeAt     DateTime?

  // Relations
  roles       UserRole[]
  sessions    Session[]
  memberships Membership[]
  attendances Attendance[]
  invoices    Invoice[]

  // Profiles
  memberProfile  MemberProfile?
  trainerProfile TrainerProfile?

  @@index([email])
  @@index([lastName, firstName, phone]) // Phase 7: Search Index
  @@index([branchId])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleType @unique
  description String?

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String    @id @default(uuid())
  action      String    // "create", "read", "update", "delete", "manage"
  resource    String    // "member", "trainer", "payment", "report", "settings", "branch"
  description String?
  createdAt   DateTime  @default(now())

  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(uuid())
  role         RoleType
  permissionId String
  createdAt    DateTime  @default(now())

  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([refreshToken]) // Phase 7: Fast Session Lookup
  @@map("sessions")
}

model Branch {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  address      String
  contactPhone String    @map("contact_phone")
  contactEmail String    @map("contact_email")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  users       User[]
  plans       Plan[]
  attendances Attendance[]
  invoices    Invoice[]
  inventory   InventoryItem[]
  equipment   Equipment[]
  classes     Class[]

  @@map("branches")
}

// ==========================================
// 2. PROFILES & MEMBERSHIPS
// ==========================================

model MemberProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dob            DateTime
  gender         String
  heightCm       Decimal? @map("height_cm") @db.Decimal(5, 2)
  weightKg       Decimal? @map("weight_kg") @db.Decimal(5, 2)
  medicalNotes   String?  @map("medical_notes")
  emergencyName  String?  @map("emergency_name")
  emergencyPhone String?  @map("emergency_phone")

  @@map("member_profiles")
}

model TrainerProfile {
  id             String  @id @default(uuid())
  userId         String  @unique @map("user_id")
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  experienceYrs  Int     @map("experience_years")
  bio            String?

  @@map("trainer_profiles")
}

model Plan {
  id           String    @id @default(uuid())
  branchId     String    @map("branch_id")
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name         String
  description  String?
  price        Decimal   @db.Decimal(10, 2)
  durationDays Int       @map("duration_days")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  memberships Membership[]

  @@index([branchId])
  @@map("plans")
}

model Membership {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String             @map("plan_id")
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    SubscriptionStatus @default(ACTIVE)

  @@index([userId])
  @@index([status, endDate]) // Phase 7: Fast dashboard queries for expiries
  @@map("memberships")
}

// ==========================================
// 3. BILLING & ATTENDANCE
// ==========================================

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique @map("invoice_number")
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  branchId      String   @map("branch_id")
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  subtotal      Decimal  @db.Decimal(10, 2)
  tax           Decimal  @db.Decimal(10, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(10, 2)
  status        String   @default("UNPAID") // UNPAID, PAID, VOID
  dueDate       DateTime @map("due_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  payment Payment?

  @@index([userId, status]) // Phase 7: Find unpaid invoices per user
  @@index([branchId, dueDate]) // Phase 7: Revenue reporting by branch and date
  @@map("invoices")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String        @unique @map("invoice_id")
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountPaid    Decimal       @map("amount_paid") @db.Decimal(10, 2)
  paymentMethod String        @map("payment_method")
  transactionId String?       @unique @map("transaction_id")
  status        PaymentStatus @default(PENDING)
  processedAt   DateTime      @default(now()) @map("processed_at")

  @@index([processedAt(sort: Desc)]) // Phase 7: Fetch latest transactions quickly
  @@map("payments")
}

model Attendance {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId     String           @map("branch_id")
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  checkInTime  DateTime         @default(now()) @map("check_in_time")
  checkOutTime DateTime?        @map("check_out_time")
  entryMethod  AttendanceMethod @default(QR_CODE) @map("entry_method")

  @@index([userId, checkInTime]) // Phase 7: User's attendance history
  @@index([branchId, checkInTime(sort: Desc)]) // Phase 7: Who is currently at a branch
  @@map("attendances")
}

// ==========================================
// 4. INVENTORY & EQUIPMENT
// ==========================================

model InventoryItem {
  id       String  @id @default(uuid())
  branchId String  @map("branch_id")
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name     String
  sku      String  @unique
  quantity Int     @default(0)
  price    Decimal @db.Decimal(10, 2)

  @@index([branchId])
  @@map("inventory_items")
}

model Equipment {
  id            String    @id @default(uuid())
  branchId      String    @map("branch_id")
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name          String
  serialNumber  String?   @unique @map("serial_number")
  status        String    @default("ACTIVE") // ACTIVE, MAINTENANCE, RETIRED
  lastServiceAt DateTime? @map("last_service_at")

  @@index([branchId])
  @@map("equipment")
}

model Class {
  id       String @id @default(uuid())
  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name     String
  capacity Int

  @@map("classes")
}
